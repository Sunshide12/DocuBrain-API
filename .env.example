APP_NAME=DocuBrain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=docubrain
DB_USERNAME=docubrain
DB_PASSWORD=docubrain

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast via Laravel Reverb (WebSockets)
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REVERB_APP_ID=docubrain-app
REVERB_APP_KEY=docubrain-key
REVERB_APP_SECRET=docubrain-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

LIGHTHOUSE_BROADCASTER=reverb

CACHE_STORE=redis
# CACHE_PREFIX=

LIGHTHOUSE_QUERY_CACHE_ENABLE=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Prefix all Redis keys for this app to avoid collisions on a shared Redis instance.
REDIS_PREFIX=docubrain_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
LIGHTHOUSE_QUEUE_BROADCASTS=false

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_MODEL=openai/gpt-4o-mini
SIMILARITY_THRESHOLD=0.35
PROCESS_DOCUMENT_TIMEOUT=300
